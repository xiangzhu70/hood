    "version": "0.2.0",
    "configurations": [
        {
            "name": "web server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/server.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "~/proj/hood_frontend/build",
                "~/proj/solana_diag/solana",
            ]
        },
        {
            "name": "diag cli",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/diag.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "~/proj/solana_diag/solana",
                "show",
            ]
        },
        {
            "name": "diag shell",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/diag.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "~/proj/data_center_sim/data_center",
                "shell",
            ]
        },
        {
            "name": "diag onecmd",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/diag.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "~/proj/data_center_sim/data_center",
                "tree",
                //    "-t",
                //    "4",
            ]
        },
        {
            "name": "diag json",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/diag.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "-j",
                "~/proj/solana_diag/solana",
                "shell",
            ]
        },
        {
            "name": "hier_build",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/hood/hier_build.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "~/proj/data_center_sim/hier.txt",
                "~/proj/data_center_sim",
            ]
        },
    ]
}